	terminologies_available = <"SNOMED Clinical Terms Australian extension","SNOMED CT Clinical Findings">
	term_definitions = <
		["en"] = <
			items = <
				["1"] = <
					text = <"mL/kg">
					description = <"1">
				>
				["at0000"] = <
					text = <"Duke activity status index (DASI)">
					description = <"A self-administered questionnaire designed to assess a patient's functional capacity by evaluating their ability to perform daily activities. Its primary purpose is to estimate the patient's peak oxygen consumption (VO2 max), a key indicator of cardiorespiratory fitness for risk stratification and treatment planning.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
