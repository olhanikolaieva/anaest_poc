	openEHR-EHR-OBSERVATION.dasi.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2023-12-31">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the results for each activity parameter and the total score for the Duke activity status index (DASI).">
			keywords = <"Duke activity status index, DASI, peak oxygen consumption, VO2 max, cardiorespiratory fitness, cardiology, risk stratification.", ...>
			use = <"Use to record the results for each component parameter and their total sum for the Duke activity status index (DASI).">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"36843720860291869fd9ffd19aa8aea7">
		["build_uid"] = <"335a2fad-2cbe-37b0-a0f3-e1794530fe7a">
		["ip_acknowledgements"] = <"This artefact includes content from SNOMED Clinical Terms® (SNOMED CT®) which is copyrighted material of the International Health Terminology Standards Development Organisation (IHTSDO). Where an implementation of this artefact makes use of SNOMED CT content, the implementer must have the appropriate SNOMED CT Affiliate license - for more information contact https://www.snomed.org/snomed-ct/get-snomed or info@snomed.org.">
		["references"] = <"Hlatky MA, Boineau RE, Higginbotham MB, Lee KL, Mark DB, Califf RM, Cobb FR, Pryor DB. A brief self-administered questionnaire to determine functional capacity (the Duke Activity Status Index). Am J Cardiol. 1989 Sep 15;64(10):651-4. doi: 10.1016/0002-9149(89)90496-7. PMID: 2782256.

Coutinho-Myrrha MA, Dias RC, Fernandes AA, Araújo CG, Hlatky MA, Pereira DG, Britto RR. Duke Activity Status Index for cardiovascular diseases: validation of the Portuguese translation. Arq Bras Cardiol. 2014 Apr;102(4):383-90. doi: 10.5935/abc.20140031. Epub 2014 Feb 17. PMID: 24652056; PMCID: PMC4028943.

Eagle KA, Berger PB, Calkins H, Chaitman BR, Ewy GA, Fleischmann KE, Fleisher LA, Froehlich JB, Gusberg RJ, Leppo JA, Ryan T, Schlant RC, Winters WL Jr, Gibbons RJ, Antman EM, Alpert JS, Faxon DP, Fuster V, Gregoratos G, Jacobs AK, Hiratzka LF, Russell RO, Smith SC Jr; American College of Cardiology; American Heart Association. ACC/AHA guideline update for perioperative cardiovascular evaluation for noncardiac surgery--executive summary: a report of the American College of Cardiology/American Heart Association Task Force on Practice Guidelines (Committee to Update the 1996 Guidelines on Perioperative Cardiovascular Evaluation for Noncardiac Surgery). J Am Coll Cardiol. 2002 Feb 6;39(3):542-53. doi: 10.1016/s0735-1097(01)01788-0. Erratum in: J Am Coll Cardiol. 2006 Jun 6;47(11):2356. PMID: 11823097.">
	>

definition
	OBSERVATION[at0000] matches {    -- Duke activity status index (DASI)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- Take care of self
										value matches {
											0|[local::at0016],
											1|[local::at0017]
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {    -- Walk indoors
										value matches {
											0|[local::at0033],
											1|[local::at0034]
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {    -- Walk 1–2 blocks on level ground
										value matches {
											0|[local::at0035],
											1|[local::at0036]
										}
									}
									ELEMENT[at0020] occurrences matches {0..1} matches {    -- Climb stairs or walk uphill
										value matches {
											0|[local::at0037],
											1|[local::at0038]
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {    -- Run a short distance
										value matches {
											0|[local::at0039],
											1|[local::at0040]
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {    -- Light work around the house
										value matches {
											0|[local::at0041],
											1|[local::at0042]
										}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {    -- Moderate work around the house
										value matches {
											0|[local::at0043],
											1|[local::at0044]
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {    -- Heavy work around the house
										value matches {
											0|[local::at0045],
											1|[local::at0046]
										}
									}
									ELEMENT[at0025] occurrences matches {0..1} matches {    -- Yardwork
										value matches {
											0|[local::at0047],
											1|[local::at0048]
										}
									}
									ELEMENT[at0026] occurrences matches {0..1} matches {    -- Have sexual relations
										value matches {
											0|[local::at0049],
											1|[local::at0050]
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {    -- Moderate recreational activities
										value matches {
											0|[local::at0051],
											1|[local::at0052]
										}
									}
									ELEMENT[at0028] occurrences matches {0..1} matches {    -- Participate in strenuous sports
										value matches {
											0|[local::at0053],
											1|[local::at0054]
										}
									}
									ELEMENT[at0056] occurrences matches {0..1} matches {    -- Total score
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::507]>
												list = <
													["1"] = <
														units = <"1">
														magnitude = <|0.0..58.2|>
														precision = <|2|>
													>
												>
											>
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {    -- VO2 peak (mL/kg)
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::507]>
												list = <
													["1"] = <
														units = <"1">
														magnitude = <|0.0..35.0|>
														precision = <|2|>
													>
												>
											>
										}
										name matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[ac0001]
												}
											}
										}
									}
									ELEMENT[at0032] occurrences matches {0..1} matches {    -- Metabolic equivalent of task
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::507]>
												list = <
													["1"] = <
														units = <"1">
														magnitude = <|0.0..10.0|>
														precision = <|2|>
													>
												>
											>
										}
										name matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[ac0003]
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0055] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0057] occurrences matches {0..*} matches {    -- Extention
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

